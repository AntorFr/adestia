{
  "name": "@antorfr/adestia-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run && npm run test:plugins",
    "test:watch": "vitest",
    "typecheck": "tsc --build && tsc -p packages/web --noEmit",
    "lint": "eslint packages",
    "build": "npm run build --workspace @antorfr/adestia-server && npm run build:web --workspace @antorfr/adestia-web",
    "test:plugins": "node --test \"plugins/*/test/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "16.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.0.0"
  }
}
