{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.mjs"],
  "exclude": ["**/node_modules/**", "scan/web/decoder.js"]
}
