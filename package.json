{
  "name": "@antorfr/demeura-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run && npm run test:plugins",
    "test:watch": "vitest",
    "typecheck": "tsc --build && tsc -p packages/web --noEmit",
    "lint": "eslint packages",
    "build": "npm run build --workspace @antorfr/demeura-server && npm run build:web --workspace @antorfr/demeura-web",
    "test:plugins": "node --test \"plugins/*/test/*.test.js\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
