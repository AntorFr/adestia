node_modules/
dist/
out/
*.log
.DS_Store
.env
.env.*
data/
dist/
*.tsbuildinfo

# Where development worktrees land (see CLAUDE.md). They are checkouts of this
# same repository — committing one would nest the repo inside itself.
.claude/worktrees/

# Screenshots are evidence for one session, not artefacts of the repo.
# The glob rather than the one directory: a scenario replayed on a second skin
# writes beside it (`bench/shots-skippy/`), and those are evidence too.
bench/shots*/
.agent/shots/

# Scratch. Material pulled out of a running instance to think with — session
# transcripts, copies of an agent's pages — is evidence for one conversation,
# not an artefact of the repository, and some of it is personal.
tmp/
