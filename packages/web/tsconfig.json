{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Not a build: nothing references this project, and it emits nothing.
    // Off, so the workspace sources the base config maps in (see `paths`)
    // are ordinary files of this program rather than a listing violation.
    "composite": false,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "module": "preserve",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
